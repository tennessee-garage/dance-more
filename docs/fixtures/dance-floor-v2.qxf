<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>4.12.0</Version>
  <Author>df2-pi (generated from interfacing/dmx_control.py)</Author>
 </Creator>
 <Manufacturer>Tennessee Garage</Manufacturer>
 <Model>Dance Floor v2</Model>
 <Type>Other</Type>
 <Channel Name="Master dimmer">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">0 dark .. 255 full</Capability>
 </Channel>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="0">Off</Capability>
  <Capability Min="1" Max="255">Strobe slow to fast</Capability>
 </Channel>
 <Channel Name="Source">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="84">Internal (playlist only)</Capability>
  <Capability Min="85" Max="169">External (Art-Net takes over)</Capability>
  <Capability Min="170" Max="255">Mix (Art-Net over the playlist)</Capability>
 </Channel>
 <Channel Name="External mix">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">External over the playlist, when source is mix</Capability>
 </Channel>
 <Channel Name="Bank">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Playlist N in name order, from 0</Capability>
 </Channel>
 <Channel Name="Program">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Entry N of the playlist, from 0</Capability>
 </Channel>
 <Channel Name="Speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="127">Slower (0 stops)</Capability>
  <Capability Min="128" Max="128">Normal</Capability>
  <Capability Min="129" Max="255">Faster (up to 4x)</Capability>
 </Channel>
 <Channel Name="Macro 1">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">The playing animation's macro 1</Capability>
 </Channel>
 <Channel Name="Macro 2">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">The playing animation's macro 2</Capability>
 </Channel>
 <Channel Name="Macro 3">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">The playing animation's macro 3</Capability>
 </Channel>
 <Channel Name="Macro 4">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">The playing animation's macro 4</Capability>
 </Channel>
 <Channel Name="Tint red">
  <Group Byte="0">Intensity</Group>
  <Colour>Red</Colour>
  <Capability Min="0" Max="255">Tint colour</Capability>
 </Channel>
 <Channel Name="Tint green">
  <Group Byte="0">Intensity</Group>
  <Colour>Green</Colour>
  <Capability Min="0" Max="255">Tint colour</Capability>
 </Channel>
 <Channel Name="Tint blue">
  <Group Byte="0">Intensity</Group>
  <Colour>Blue</Colour>
  <Capability Min="0" Max="255">Tint colour</Capability>
 </Channel>
 <Channel Name="Tint amount">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">0 off .. 255 fully the tint</Capability>
 </Channel>
 <Channel Name="Bump">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">A flash of value/255 each time it rises</Capability>
 </Channel>
 <Channel Name="Hold">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="127">Run (the playlist advances)</Capability>
  <Capability Min="128" Max="255">Hold (the playing entry plays on)</Capability>
 </Channel>
 <Channel Name="Palette">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="0">rainbow</Capability>
  <Capability Min="1" Max="1">fire</Capability>
  <Capability Min="2" Max="2">ice</Capability>
  <Capability Min="3" Max="3">ocean</Capability>
  <Capability Min="4" Max="4">sunset</Capability>
  <Capability Min="5" Max="5">forest</Capability>
  <Capability Min="6" Max="6">neon</Capability>
  <Capability Min="7" Max="7">candy</Capability>
  <Capability Min="8" Max="8">night</Capability>
  <Capability Min="9" Max="255">User palettes, by name</Capability>
 </Channel>
